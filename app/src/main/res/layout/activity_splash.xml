<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    tools:context=".MainActivity"
    android:background="@drawable/splash_gradient_background">

    <!-- Decorative Background Circles -->
    <View
        android:id="@+id/circleTop"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/circle_large_transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-100dp"
        android:layout_marginEnd="-100dp"
        android:alpha="0.3" />

    <View
        android:id="@+id/circleBottom"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:background="@drawable/circle_medium_transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="-80dp"
        android:layout_marginStart="-80dp"
        android:alpha="0.3" />

    <!-- Logo Container with Elevated Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/logoCard"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:cardCornerRadius="110dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.32">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_logo"
            android:padding="44dp"
            android:src="@drawable/app_logo"
            android:scaleType="fitCenter" />
    </androidx.cardview.widget.CardView>

    <!-- Animated Pulse Ring -->
    <View
        android:id="@+id/pulseRing"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="@drawable/circle_white_transparent"
        android:alpha="0.4"
        app:layout_constraintTop_toTopOf="@id/logoCard"
        app:layout_constraintBottom_toBottomOf="@id/logoCard"
        app:layout_constraintStart_toStartOf="@id/logoCard"
        app:layout_constraintEnd_toEndOf="@id/logoCard" />

    <!-- Welcome Text -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:alpha="0.85"
        android:fontFamily="sans-serif-light"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/logoCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- App Name with Letter Spacing -->
    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WellTrack"
        android:textSize="52sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:letterSpacing="0.05"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/welcomeText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tagline with Better Styling -->
    <TextView
        android:id="@+id/tagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:text="@string/app_tagline"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:alpha="0.9"
        android:gravity="center"
        android:fontFamily="sans-serif-light"
        app:layout_constraintTop_toBottomOf="@id/appName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Decorative Accent Line -->
    <View
        android:id="@+id/accentLine"
        android:layout_width="100dp"
        android:layout_height="4dp"
        android:background="@drawable/decorative_line"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Modern Next Button with Shadow -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="30dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@android:color/white"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/nextButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/next"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            android:letterSpacing="0.05" />
    </androidx.cardview.widget.CardView>

    <!-- Feature Pills Row -->
    <LinearLayout
        android:id="@+id/featurePills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/accentLine"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Pill 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Habits"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:background="@drawable/pill_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="8dp" />

        <!-- Pill 2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mood"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:background="@drawable/pill_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="8dp" />

        <!-- Pill 3 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💧 Hydration"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:background="@drawable/pill_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </LinearLayout>

    <!-- Version Text -->
    <TextView
        android:id="@+id/versionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 1.0.0"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:alpha="0.5"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>