<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
		android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/habitEmoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="✓"
            android:textSize="28sp"
            android:gravity="center"
            android:background="@drawable/circle_blue_light" />

        <TextView
            android:id="@+id/habitName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Drink Water"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginStart="16dp" />

		<CheckBox
			android:id="@+id/habitCheckbox"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:buttonTint="#1976D2" />

		<ImageButton
			android:id="@+id/btnEditHabit"
			android:layout_width="36dp"
			android:layout_height="36dp"
			android:layout_marginStart="8dp"
			android:background="@android:color/transparent"
			android:contentDescription="Edit Habit"
			android:src="@android:drawable/ic_menu_edit" />

		<ImageButton
			android:id="@+id/btnDeleteHabit"
			android:layout_width="36dp"
			android:layout_height="36dp"
			android:layout_marginStart="4dp"
			android:background="@android:color/transparent"
			android:contentDescription="Delete Habit"
			android:src="@android:drawable/ic_menu_delete" />
    </LinearLayout>
</androidx.cardview.widget.CardView>